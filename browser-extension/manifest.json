{
  "manifest_version": 3,
  "name": "PhishX: AI Phishing Protection",
  "version": "1.0.0",
  "description": "Real-time AI-powered phishing detection for a safer browsing experience.",
  "permissions": ["tabs", "storage", "activeTab", "contextMenus", "scripting"],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content_script.js"]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
